{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main-branch.sh\"",
            "statusMessage": "main 直接コミットの確認"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-shift-search-report.sh\"",
            "statusMessage": "Shift Search 同期"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-agent-skills.sh\"",
            "statusMessage": "スキルスタブ同期"
          }
        ]
      }
    ]
  }
}
